# Create this bot with @BotFather.
TELEGRAM_BOT_TOKEN=

# Comma-separated Telegram numeric user IDs. Start with this empty, send
# /whoami to the bot, then add the returned ID and restart the bot.
TELEGRAM_ALLOWED_USER_IDS=

# Personal access token used by this private, single-owner MVP.
# It needs Issues read/write and repository metadata read access for the selected resources.
GITHUB_TOKEN=

# Persistent state is mounted here by compose.yaml.
DATA_FILE=/data/state.json

# Optional tuning.
GITHUB_API_VERSION=2026-03-10
LIST_PAGE_SIZE=8
MESSAGE_BODY_LIMIT=60000
